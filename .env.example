POSTGRES_DB=autonomous_noc
POSTGRES_USER=noc
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://noc:change-me@postgres:5432/autonomous_noc
LLM_PROVIDER=ollama
LLM_MODEL=gpt-5.6-sol
